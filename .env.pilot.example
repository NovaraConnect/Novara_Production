# --- BACKEND: Render web service "Novara-Mobile2" (srv-d95fn6hkh4rs738f0jng) ---
#     URL: https://novara-mobile2.onrender.com   Plan: Starter   Auto-Deploy: OFF
NODE_ENV=production
DATABASE_URL=<pilot Neon pooled connection string>          # SECRET
CLERK_PUBLISHABLE_KEY=pk_test_<pilot Clerk dev instance>
CLERK_SECRET_KEY=sk_test_<pilot Clerk dev instance>          # SECRET
FRONTEND_URL=https://novara-mobile2-frontend.onrender.com
GNEWS_API_KEY=<pilot GNews key>                             # SECRET
VAPID_PUBLIC_KEY=<pilot>
VAPID_PRIVATE_KEY=<pilot>                                   # SECRET
VAPID_SUBJECT=mailto:hello@novara.app
RESEND_API_KEY=<pilot or unset>                            # SECRET
FEEDBACK_TO_EMAIL=novaraconnect@gmail.com

# --- FRONTEND: Render static "Novara-Mobile2-frontend" (srv-d95g49vlk1mc73cjopfg) ---
VITE_API_BASE_URL=https://novara-mobile2.onrender.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_<pilot Clerk dev instance>
VITE_CLERK_PROXY_URL=https://novara-mobile2.onrender.com/api/__clerk

# --- Notes ---
# - Clerk is a DEVELOPMENT instance (pk_test_/sk_test_). Fine for pilot users.
# - Auto-Deploy is OFF; pilot runs whatever commit was last deployed manually.
# - Do not repoint, rotate, or delete any of the above while the pilot is live.
