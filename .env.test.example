# =============================================================================
# Novara TEST environment (.env.test.example)
# For a throwaway test stack (test Neon branch + test Clerk dev + novara-test-api).
# Real values are entered in the Render/Neon/Clerk dashboards, never committed.
# =============================================================================

# --- Test backend (Render web service "novara-test-api") ---
NODE_ENV=production
DATABASE_URL=<TEST Neon pooled connection string>        # SECRET
CLERK_PUBLISHABLE_KEY=pk_test_<test Clerk instance>
CLERK_SECRET_KEY=sk_test_<test Clerk instance>           # SECRET
FRONTEND_URL=http://localhost:8081                       # Expo dev origin (or test web origin)
GNEWS_API_KEY=<optional test key>                        # SECRET
RESEND_API_KEY=<optional>                                # SECRET
FEEDBACK_TO_EMAIL=you@example.com

# --- Mobile app (artifacts/novara-mobile/.env.local — gitignored) ---
EXPO_PUBLIC_API_BASE_URL=https://novara-test-api.onrender.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<test Clerk instance>
