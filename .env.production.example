# =============================================================================
# Novara PRODUCTION environment value map (.env.production.example)
# =============================================================================
# For the NEW production environment (new Render services, new Neon branch,
# Clerk PRODUCTION instance, custom domain). Fill real values in Render's
# dashboard — never commit them. Placeholders show the intended wiring.
# =============================================================================

# --- BACKEND: new Render web service (suggested name "novara-prod-api") -------
#     Suggested custom domain: https://api.novaraconnect.group
NODE_ENV=production
DATABASE_URL=<PRODUCTION Neon branch pooled connection string>   # SECRET
CLERK_PUBLISHABLE_KEY=pk_live_<production Clerk instance>
CLERK_SECRET_KEY=sk_live_<production Clerk instance>              # SECRET
FRONTEND_URL=https://app.novaraconnect.group                     # exact prod frontend origin
GNEWS_API_KEY=<production GNews key — consider a separate/paid key>  # SECRET
VAPID_PUBLIC_KEY=<generate a NEW production VAPID keypair>
VAPID_PRIVATE_KEY=<generate a NEW production VAPID keypair>       # SECRET
VAPID_SUBJECT=mailto:hello@novaraconnect.group
RESEND_API_KEY=<production Resend key>                           # SECRET
RESEND_FROM_EMAIL=feedback@novaraconnect.group                   # verify domain in Resend
FEEDBACK_TO_EMAIL=novaraconnect@gmail.com
LOG_LEVEL=info

# --- FRONTEND: new Render static site (suggested name "novara-prod-web") ------
#     Suggested custom domain: https://app.novaraconnect.group
VITE_API_BASE_URL=https://api.novaraconnect.group
VITE_CLERK_PUBLISHABLE_KEY=pk_live_<production Clerk instance>
VITE_CLERK_PROXY_URL=https://api.novaraconnect.group/api/__clerk

# --- MOBILE: Expo / EAS build -------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=https://api.novaraconnect.group

# --- Rules ---
# - Use Clerk PRODUCTION keys (pk_live_/sk_live_) — never promote pilot dev keys.
# - Generate a NEW VAPID keypair for production (don't reuse pilot's).
# - DATABASE_URL must point at the NEW Neon production branch, never the pilot DB.
# - Keep FRONTEND_URL / VITE_API_BASE_URL / VITE_CLERK_PROXY_URL mutually consistent.
