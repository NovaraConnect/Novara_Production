# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon or any Postgres provider)
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Clerk authentication ──────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_live_
CLERK_SECRET_KEY=sk_live_

# ── News ──────────────────────────────────────────────────────────────────────
# GNews.io API key — https://gnews.io (100 req/day on free tier)
GNEWS_API_KEY=

# ── Web push notifications (optional) ────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# If not set, push notifications are silently disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@novara.app

# ── In-app feedback / bug reports ────────────────────────────────────────────
# Resend API key — https://resend.com (free tier: 3,000 emails/month).
# Sign up, create an API key, and paste it here / into Render. If unset, new
# feedback submissions are still saved to the database, but no email
# notification is sent (see artifacts/api-server/src/lib/email.ts).
RESEND_API_KEY=
# Inbox that receives new feedback/bug-report notifications.
FEEDBACK_TO_EMAIL=novaraconnect@gmail.com
# Sender address for feedback notification emails. The default below (Resend's
# shared sandbox sender) works with no setup but can only deliver to the
# email address that owns the Resend account. For reliable delivery to any
# FEEDBACK_TO_EMAIL, verify a domain in Resend and set this to an address on
# that domain (e.g. "Novara Feedback <feedback@yourdomain.com>").
RESEND_FROM_EMAIL=Novara Feedback <onboarding@resend.dev>

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Exact origin of the deployed frontend. Used for the CORS allowlist and as
# Clerk's authorizedParties. Must NOT have a trailing slash.
FRONTEND_URL=https://novara-mobile2-frontend.onrender.com
