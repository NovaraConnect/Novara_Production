    "@workspace/novara-priority": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express-rate-limit": "^8.5.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^6.17.2",
    "web-push": "^3.6.7"
