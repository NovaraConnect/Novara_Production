# ── Vite dev server / build ───────────────────────────────────────────────────
# Port for local dev server (any free port)
PORT=5173

# Base URL path. Use / for root deployment, /novara for a subpath deployment.
BASE_PATH=/

# ── Clerk authentication ──────────────────────────────────────────────────────
# Publishable key from your Clerk dashboard (pk_live_... or pk_test_...)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_

# URL of the Clerk Frontend API proxy on your API server.
# Format: https://<your-api-domain>/api/__clerk
# Leave blank for local dev (Clerk will use its default endpoint).
VITE_CLERK_PROXY_URL=

# ── API server ────────────────────────────────────────────────────────────────
# Absolute base URL of the API server.
# Leave blank when frontend and API share the same origin (same domain / Vercel rewrite).
# Set to https://<your-api>.onrender.com when deploying frontend and API separately.
VITE_API_BASE_URL=
