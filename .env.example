# =============================================================================
# Novara — Canonical environment template (.env.example)
# =============================================================================
# This is the ANNOTATED reference for every environment variable Novara reads.
# Copy the relevant block into each Render service's env settings (backend and
# frontend are SEPARATE Render services with different vars). Never commit real
# values. Environment-specific value maps live in:
#   - .env.pilot.example       (existing MBA pilot)
#   - .env.production.example  (new production environment)
#
# Secret? = do not expose in client bundles or logs. Vite (VITE_*) vars are
# baked into the browser bundle at build time and are therefore NEVER secret.
# -----------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# BACKEND  (artifacts/api-server  ->  Render web service)
# ---------------------------------------------------------------------------
NODE_ENV=production                     # production | development
PORT=8080                               # Render injects this; server requires it

# Database (Neon Postgres). db.ts reads DATABASE_URL first, then NEON_DATABASE_URL.
# Use a POOLED Neon connection string (…-pooler.neon.tech) for serverless-style hosts.
DATABASE_URL=                           # SECRET — postgres://USER:PASS@HOST/DB?sslmode=require

# Auth (Clerk). Backend verifies sessions; must be the SAME Clerk instance as the frontend.
CLERK_PUBLISHABLE_KEY=                  # pk_test_… (pilot) or pk_live_… (production)
CLERK_SECRET_KEY=                       # SECRET — sk_test_… (pilot) or sk_live_… (production)

# CORS + Clerk authorizedParties. MUST equal the exact frontend origin (no trailing slash).
FRONTEND_URL=                           # e.g. https://app.novaraconnect.group

# News feature (GNews.io). Route is auth-gated; free tier = 100 req/day.
GNEWS_API_KEY=                          # SECRET

# Web Push (feature-gated). If either key is missing, the notification cron disables itself.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                      # SECRET
VAPID_SUBJECT=mailto:hello@novaraconnect.group

# Feedback email (Resend, feature-gated). Feedback still saves to DB if unset.
RESEND_API_KEY=                         # SECRET
RESEND_FROM_EMAIL=                      # e.g. feedback@novaraconnect.group (verify domain in Resend)
FEEDBACK_TO_EMAIL=novaraconnect@gmail.com
LOG_LEVEL=info                          # pino level: trace|debug|info|warn|error

# ---------------------------------------------------------------------------
# FRONTEND  (artifacts/project-novara  ->  Render static site)
# Vite build-time vars — baked into the browser bundle, NOT secret.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=                      # backend origin, e.g. https://api.novaraconnect.group
VITE_CLERK_PUBLISHABLE_KEY=             # pk_test_… (pilot) or pk_live_… (production)
VITE_CLERK_PROXY_URL=                   # backend origin + /api/__clerk, e.g. https://api.novaraconnect.group/api/__clerk

# ---------------------------------------------------------------------------
# MOBILE  (artifacts/novara-mobile  ->  Expo / EAS build)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=               # backend origin the app calls, e.g. https://api.novaraconnect.group
